{
  "$schema": "https://opencode.ai/config.json",

  // Standard (single-file) configuration — native OpenCode V2 format.
  // Every agent, command, and setting lives in this one file.
  // Models use the built-in GitHub Copilot provider; sign in once with /connect.

  // Default model for sessions that do not select one.
  "model": "github-copilot/claude-sonnet-5",
  "default_agent": "build",

  // Agents. `agents` replaces the V1 `agent` map; `permissions` is an ordered rule
  // list (last match wins) that replaces the V1 `tools` and `permission` maps.
  // An action no rule mentions is ALLOWED — the base policy starts with allow-all.
  "agents": {
    // The built-in title agent replaces the V1 `small_model` setting.
    "title": {
      "model": "github-copilot/gpt-5-mini"
    },

    // Fast general tasks. No rules: full tool access through the base policy.
    "quick": {
      "description": "Fast agent for basic tasks like code formatting, simple queries, and quick fixes",
      "mode": "primary",
      "model": "github-copilot/gpt-5-mini"
    },

    // Code review — read-only. Denies edit/write/patch and shell.
    "reviewer": {
      "description": "Code review agent that analyzes code without making changes",
      "mode": "subagent",
      "model": "github-copilot/claude-sonnet-5",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },

    // Documentation — may edit files, may not run shell commands.
    "docs": {
      "description": "Documentation agent for creating and maintaining project documentation",
      "mode": "subagent",
      "model": "github-copilot/claude-haiku-4.5",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    }
  },

  // Slash commands. `commands` replaces the V1 `command` map.
  "commands": {
    "quick-fix": {
      "template": "Make a quick fix for: $ARGUMENTS. Keep it simple and fast.",
      "description": "Quick fixes using the fast agent",
      "agent": "quick"
    },
    "build": {
      "template": "Build and test the project. Focus on: $ARGUMENTS",
      "description": "Build tasks optimized for compilation"
    },
    "review": {
      "template": "Review the following code for quality, security, and best practices: $ARGUMENTS",
      "description": "Code review without modifications",
      "agent": "reviewer",
      "subagent": true
    },
    "document": {
      "template": "Create or update documentation for: $ARGUMENTS. Include examples and clear explanations.",
      "description": "Documentation creation and updates",
      "agent": "docs"
    },
    "test": {
      "template": "Run tests for $ARGUMENTS. If tests fail, analyze and suggest fixes.",
      "description": "Run and fix tests"
    },
    "deploy": {
      "template": "Deploy the application. Handle: $ARGUMENTS",
      "description": "Deployment tasks"
    }
  },

  // Global permission rules, applied before every agent's own rules.
  // Allow shell generally, but ask before any push.
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" }
  ],

  // MCP servers live under mcp.servers in V2. Servers connect automatically;
  // set "disabled": true to keep one configured without connecting it.
  // Substitute environment variables with {env:NAME}.
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer {env:GITHUB_TOKEN}"
        }
      }
    }
  },

  // Update checks: "disable", "notify", or "auto". Honored only in the global
  // config (~/.config/opencode/opencode.json); ignored in a project config.
  "update": "notify",

  "share": "manual"

  // Not here in V2:
  // - "theme" and keybinds belong in the terminal client config, ~/.config/opencode/cli.json.
  // - "instructions" is accepted but not loaded. Put project guidance in AGENTS.md,
  //   which V2 discovers automatically.
}
