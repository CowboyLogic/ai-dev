{
  "$schema": "https://opencode.ai/config.json",

  // The GitHub MCP server from the Docker Desktop MCP Toolbox, run as a local container.
  // OpenCode V2 format: servers live under mcp.servers and connect automatically.
  "mcp": {
    "servers": {
      "docker-desktop-github": {
        "type": "local",
        "command": ["docker", "run", "--rm", "-i", "docker/desktop-mcp-toolbox-github:latest"],
        "environment": {
          // {env:NAME} reads the variable from your shell. Never hardcode a secret here.
          "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
        },
        "timeout": { "catalog": 30000, "execution": 30000 }
      }
    }
  }
}
