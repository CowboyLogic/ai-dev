{
  "$schema": "https://opencode.ai/config.json",

  // A local MCP server run from an npm package with npx (here, the Snyk MCP server).
  // OpenCode V2 format: servers live under mcp.servers and connect automatically.
  "mcp": {
    "servers": {
      "snyk": {
        "type": "local",
        // -y installs the package without prompting. Pin a version for reproducible runs.
        "command": ["npx", "-y", "@snyk/mcp-server"],
        "environment": {
          // {env:NAME} reads the variable from your shell. Never hardcode a secret here.
          "SNYK_TOKEN": "{env:SNYK_TOKEN}"
        },
        "timeout": { "catalog": 15000, "execution": 15000 }
      }
    }
  }
}
